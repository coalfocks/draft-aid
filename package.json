{
  "name": "fantasy-draft-assistant",
  "version": "1.0.0",
  "description": "AI-powered fantasy football draft assistant",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
